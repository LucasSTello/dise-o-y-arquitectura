<section class="page-header">
  <h1>Catálogo de Productos</h1>
  <p class="subtitle">Visualización estática de los productos almacenados en nuestro sistema.</p>
</section>

{{#if error}}
  <div class="alert alert-error">
    <p>{{error}}</p>
  </div>
{{/if}}

{{#if products.length}}
  <div class="products-grid">
    {{#each products}}
      <article class="product-card">
        <div class="card-header">
          <span class="category-badge">{{this.category}}</span>
          <span class="product-id">ID: #{{this.id}}</span>
        </div>
        <div class="card-body">
          <h3 class="product-title">{{this.title}}</h3>
          <p class="product-description">{{this.description}}</p>
          <div class="product-meta">
            <span class="meta-item"><strong>Código:</strong> {{this.code}}</span>
            <span class="meta-item"><strong>Stock:</strong> {{this.stock}} u.</span>
          </div>
        </div>
        <div class="card-footer">
          <span class="product-price">${{this.price}}</span>
        </div>
      </article>
    {{/each}}
  </div>
{{else}}
  <div class="empty-state">
    <span class="empty-icon">📦</span>
    <h3>No hay productos disponibles</h3>
    <p>No se encontraron productos registrados en el sistema en este momento.</p>
  </div>
{{/if}}
